# Normalize all text files to LF line endings in the repository,
# regardless of the platform they were checked out or committed from.
# This avoids CRLF breaking scripts run under WSL/Linux (bash chokes on
# the trailing \r), while LF causes no issues on Windows.
* text=auto eol=lf
# Explicitly mark known binary formats so they are never touched.
# .pt (model checkpoints, can be 100s of MB) is stored via Git LFS instead of inline.
*.pt filter=lfs diff=lfs merge=lfs -text
*.png binary
*.pkl binary
